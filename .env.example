# PALATE runtime configuration. Copy to .env for local use, or set these in
# your hosting provider's dashboard.

# --- Qloo API (required for live mode) ---------------------------------------
# Request a hackathon key here (form, provisioned manually — allow a few
# business days):
# https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide#getting-your-api-key
QLOO_API_KEY=

# Hackathon keys ONLY work against this base URL (verified 2026-10-27).
QLOO_BASE_URL=https://hackathon.api.qloo.com

# --- Mode --------------------------------------------------------------------
# auto  = live when QLOO_API_KEY is set, otherwise mock  (default)
# live  = require the real Qloo API; fail fast if no key
# mock  = always use the bundled synthetic taste graph
PALATE_MODE=auto

# When a live run produces no Qloo results at all, fall back to a clearly
# labelled simulated run instead of showing an error page (1 = on, 0 = off).
PALATE_MOCK_FALLBACK=1

# Request timeout in seconds for Qloo calls (optional).
QLOO_TIMEOUT=15

# --- Server ------------------------------------------------------------------
# Local default is 8000. Hosting providers usually inject PORT.
PORT=8000
